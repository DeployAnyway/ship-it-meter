{
  "name": "@deployanyway/ship-it-meter",
  "version": "0.4.0",
  "description": "Explainable deployment readiness scoring for tests, coverage, and builds. Turns questionable confidence into a number.",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "ship-it-meter": "./bin/cli.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dist",
    "index.d.ts",
    "index.d.cts",
    "MIGRATION.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "coverage": "c8 --all --include=src/**/*.js --reporter=text --reporter=json-summary --reporter=lcov --check-coverage --lines=90 --statements=90 --functions=90 --branches=85 node --test test/*.test.js",
    "test:types": "tsc -p tsconfig.json",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeployAnyway/ship-it-meter.git"
  },
  "bugs": {
    "url": "https://github.com/DeployAnyway/ship-it-meter/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "nodejs",
    "javascript",
    "cli",
    "developer-tools",
    "deployment",
    "readiness",
    "test-coverage",
    "build",
    "scoring",
    "typescript",
    "humor",
    "deployanyway"
  ],
  "main": "./dist/index.cjs",
  "types": "./index.d.ts",
  "homepage": "https://deployanyway.github.io/"
}
